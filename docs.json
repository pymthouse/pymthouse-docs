{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PymtHouse",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Builder guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "integration/integration-patterns"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "integration/client-model",
              "integration/api-keys",
              "integration/sdk"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "integration/machine-access",
              "integration/interactive-login",
              "integration/device-flow",
              "integration/token-exchange"
            ]
          },
          {
            "group": "Users",
            "pages": [
              "integration/user-management",
              "integration/user-tokens",
              "integration/allowances"
            ]
          },
          {
            "group": "Billing",
            "pages": [
              "integration/billing",
              "integration/plans",
              "integration/usage-api"
            ]
          },
          {
            "group": "Infrastructure",
            "pages": [
              "integration/signer-routing",
              "integration/manifest"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "integration/troubleshooting",
              "integration/deprecated"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/eliteprox/pymthouse",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode"]
  }
}
